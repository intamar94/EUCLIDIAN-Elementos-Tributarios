{
  "rewrites": [
    {
      "source": "/impressum",
      "destination": "/api/impressum"
    },
    {
      "source": "/impressum.html",
      "destination": "/api/impressum"
    },
    {
      "source": "/datenschutz",
      "destination": "/api/datenschutz"
    },
    {
      "source": "/datenschutz.html",
      "destination": "/api/datenschutz"
    },
    {
      "source": "/privacidad",
      "destination": "/api/datenschutz"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  }
}
