{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "euclidian-preview",
  "main": "cloudflare/worker.js",
  "compatibility_date": "2026-10-19",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist-cloudflare/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "vars": {
    "EUCLIDIAN_CLOUDFLARE_MODE": "preview",
    "EUCLIDIAN_PUBLIC_ACCESS_ENABLED": "0",
    "EUCLIDIAN_SIGNUP_ENABLED": "false",
    "EUCLIDIAN_LEGAL_APPROVED": "0",
    "EUCLIDIAN_APORTES_ENABLED": "0",
    "EUCLIDIAN_BILLING_ENABLED": "false",
    "EUCLIDIAN_PRICING_PUBLICADO": "false"
  },
  "observability": {"enabled": true, "head_sampling_rate": 0.1, "logs": {"enabled": true, "invocation_logs": false}}
}
